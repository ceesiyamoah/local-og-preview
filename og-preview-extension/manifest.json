{
  "manifest_version": 3,
  "name": "OG Link Preview",
  "description": "Preview how links look when shared, validate Open Graph tags, and see which AI crawlers can read the page.",
  "version": "1.2",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
